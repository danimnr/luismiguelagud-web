---
interface Red {
  red: string;
  url: string;
  etiqueta: string;
}
interface Props {
  redes: Red[];
  clase?: string;
  mostrarEtiqueta?: boolean;
}
const { redes, clase = '', mostrarEtiqueta = false } = Astro.props;

const iconos: Record<string, string> = {
