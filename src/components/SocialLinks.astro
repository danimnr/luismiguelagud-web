  substack: `<svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M22.539 8.242H1.46V5.406h21.08v2.836zM1.46 10.812V24L12 18.11 22.54 24V10.812H1.46zM22.54 0H1.46v2.836h21.08V0z"/></svg>`,
};
---

<ul class={`flex items-center gap-4 ${clase}`} role="list">
  {redes.map((r) => (
    <li>
      <a
        href={r.url}
        target="_blank"
        rel="noopener noreferrer"
        class="flex items-center gap-2 text-gris hover:text-oro transition-colors duration-300"
        aria-label={r.etiqueta}
      >
        <span set:html={iconos[r.red] ?? ''} />
        {mostrarEtiqueta && <span class="text-sm">{r.etiqueta}</span>}
      </a>
    </li>
  ))}
</ul>
