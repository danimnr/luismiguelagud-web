---
import SectionHeading from './SectionHeading.astro';
import SocialLinks from './SocialLinks.astro';
import { readFileSync } from 'fs';
import yaml from 'js-yaml';
import path from 'path';

const cfgPath = path.join(process.cwd(), 'src/data/config.yaml');
const cfgRaw = yaml.load(readFileSync(cfgPath, 'utf8')) as any;
const cfg = {
  seo: cfgRaw?.seo ?? { titulo_sitio: 'Luismi Agud', descripcion: '', imagen_og: '' },
  nav: cfgRaw?.nav ?? { inicio: 'Inicio', sobre_mi: 'Sobre mí', libros: 'Libros', articulos: 'Artículos', contacto: 'Contacto' },
  hero: cfgRaw?.hero ?? { titulo: 'Luismi Agud', lema: '', presentacion: '', imagen: '/images/placeholder/hero-autor.jpg', imagen_alt: '', boton_libros: 'Ver mis libros', boton_autor: 'Conocerme' },
  secciones: cfgRaw?.secciones ?? { libros: true, articulos: true, apariciones: true, contacto: true },
  contacto: cfgRaw?.contacto ?? { texto_intro: '', email: 'hola@luismiguelagud.com', boton_email: 'Escribir un correo' },
  footer: cfgRaw?.footer ?? { texto_legal: '© {year} Luis Miguel Agud Sorlí.', aviso_legal: true, politica_privacidad: true, politica_cookies: false },
};
const autorPath = path.join(process.cwd(), 'src/data/autor.yaml');
const autor = yaml.load(readFileSync(autorPath, 'utf8')) as any;
---

<section
  id="contacto"
  class="py-section bg-tinta dark:bg-tinta text-crema"
  aria-labelledby="contacto-titulo"
>
  <div class="container mx-auto px-6 lg:px-10 max-w-3xl text-center">
    <div class="flex justify-center mb-0">
      <span class="block w-12 h-px bg-oro my-4" aria-hidden="true"></span>
    </div>

    <h2
      id="contacto-titulo"
      class="font-display text-display-lg text-crema leading-tight mb-6 reveal"
    >
      Hablemos
    </h2>

    <p class="font-body text-base lg:text-lg text-crema/70 leading-relaxed mb-10 reveal" style="transition-delay:0.1s">
      {cfg.contacto.texto_intro}
    </p>

    <div class="reveal" style="transition-delay:0.2s">
      <a
        href={`mailto:${cfg.contacto.email}`}
        class="inline-flex items-center gap-3 px-8 py-4 bg-oro text-tinta font-body font-medium tracking-wide hover:bg-crema hover:text-tinta transition-colors duration-300 text-sm"
      >
        <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24" aria-hidden="true">
          <path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"/><polyline points="22,6 12,13 2,6"/>
        </svg>
        {cfg.contacto.boton_email}
      </a>
    </div>

    {autor.redes?.length > 0 && (
      <div class="mt-12 reveal" style="transition-delay:0.3s">
        <p class="font-body text-xs font-medium tracking-widest uppercase text-crema/40 mb-4">
          O encuéntrame en
        </p>
        <div class="flex justify-center">
          <SocialLinks
            redes={autor.redes}
            clase="[&_a]:text-crema/50 [&_a:hover]:text-oro"
          />
        </div>
      </div>
    )}
  </div>
</section>
