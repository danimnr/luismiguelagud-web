---
import SocialLinks from './SocialLinks.astro';
import { readFileSync } from 'fs';
import yaml from 'js-yaml';
import { fileURLToPath } from 'url';
import path from 'path';

const cfgPath = path.join(process.cwd(), 'src/data/config.yaml');
const cfg = yaml.load(readFileSync(cfgPath, 'utf8')) as any;
const autorPath = path.join(process.cwd(), 'src/data/autor.yaml');
const autor = yaml.load(readFileSync(autorPath, 'utf8')) as any;
---

<header
  id="site-header"
  class="fixed top-0 left-0 right-0 z-50 transition-all duration-500"
  role="banner"
>
  <div class="absolute inset-0 bg-crema/90 dark:bg-crema-dark/90 backdrop-blur-sm transition-colors duration-300 opacity-0" id="header-bg" aria-hidden="true"></div>

  <div class="relative container mx-auto px-6 lg:px-10 flex items-center justify-between h-16 lg:h-20">

    <!-- Logo / nombre -->
    <a
      href="/#inicio"
      class="font-display font-bold text-tinta dark:text-tinta-dark hover:text-oro transition-colors duration-300 text-xl tracking-tight"
      aria-label="Ir al inicio"
    >
      <span class="text-oro">L</span>uis Miguel Agud
    </a>

    <!-- Navegación desktop -->
    <nav class="hidden lg:flex items-center gap-8" aria-label="Navegación principal">
      <a href="/#inicio"    class="nav-link">{cfg.nav.inicio}</a>
      <a href="/#sobre-mi"  class="nav-link">{cfg.nav.sobre_mi}</a>
      <a href="/#libros"    class="nav-link">{cfg.nav.libros}</a>
      <a href="/#articulos" class="nav-link">{cfg.nav.articulos}</a>
      <a href="/#contacto"  class="nav-link">{cfg.nav.contacto}</a>
    </nav>

    <!-- Acciones -->
    <div class="flex items-center gap-3">
      <!-- Toggle tema -->
      <button
        id="theme-toggle"
        class="p-2 text-gris hover:text-oro transition-colors duration-300 rounded"
        aria-label="Cambiar tema claro/oscuro"
        type="button"
      >
        <!-- Sol (modo claro) -->
        <svg id="icon-sun" class="w-5 h-5 hidden" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24" aria-hidden="true">
          <circle cx="12" cy="12" r="5"/><line x1="12" y1="1" x2="12" y2="3"/><line x1="12" y1="21" x2="12" y2="23"/>
          <line x1="4.22" y1="4.22" x2="5.64" y2="5.64"/><line x1="18.36" y1="18.36" x2="19.78" y2="19.78"/>
          <line x1="1" y1="12" x2="3" y2="12"/><line x1="21" y1="12" x2="23" y2="12"/>
          <line x1="4.22" y1="19.78" x2="5.64" y2="18.36"/><line x1="18.36" y1="5.64" x2="19.78" y2="4.22"/>
        </svg>
        <!-- Luna (modo oscuro) -->
        <svg id="icon-moon" class="w-5 h-5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24" aria-hidden="true">
          <path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"/>
        </svg>
      </button>

      <!-- Menú móvil -->
      <button
        id="menu-toggle"
        class="lg:hidden p-2 text-gris hover:text-tinta dark:hover:text-tinta-dark transition-colors"
        aria-label="Abrir menú"
        aria-expanded="false"
        aria-controls="mobile-menu"
        type="button"
      >
        <span id="menu-icon-open" class="block" aria-hidden="true">
          <svg class="w-6 h-6" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
            <line x1="3" y1="6" x2="21" y2="6"/><line x1="3" y1="12" x2="21" y2="12"/><line x1="3" y1="18" x2="21" y2="18"/>
          </svg>
        </span>
        <span id="menu-icon-close" class="hidden" aria-hidden="true">
          <svg class="w-6 h-6" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
            <line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/>
          </svg>
        </span>
      </button>
    </div>
  </div>

  <!-- Menú móvil -->
  <nav
    id="mobile-menu"
    class="lg:hidden hidden bg-crema dark:bg-crema-dark border-t border-arena dark:border-arena-dark"
    aria-label="Menú móvil"
  >
    <ul class="flex flex-col divide-y divide-arena dark:divide-arena-dark" role="list">
      {[
        ['/#inicio', cfg.nav.inicio],
        ['/#sobre-mi', cfg.nav.sobre_mi],
        ['/#libros', cfg.nav.libros],
        ['/#articulos', cfg.nav.articulos],
        ['/#contacto', cfg.nav.contacto],
      ].map(([href, label]) => (
        <li>
          <a
            href={href}
            class="block px-6 py-4 font-body text-tinta dark:text-tinta-dark hover:text-oro dark:hover:text-oro transition-colors"
          >
            {label}
          </a>
        </li>
      ))}
    </ul>
  </nav>
</header>

<style>
  .nav-link {
    @apply font-body text-sm font-medium text-gris hover:text-tinta dark:text-gris dark:hover:text-tinta-dark
           transition-colors duration-300 relative after:absolute after:bottom-0 after:left-0 after:w-0
           after:h-px after:bg-oro after:transition-all after:duration-300 hover:after:w-full pb-0.5;
  }
</style>

<script>
  // ── Fondo header al hacer scroll ──────────────────────
  const headerBg = document.getElementById('header-bg');
  window.addEventListener('scroll', () => {
    if (window.scrollY > 60) {
      headerBg?.classList.remove('opacity-0');
      headerBg?.classList.add('opacity-100');
    } else {
      headerBg?.classList.remove('opacity-100');
      headerBg?.classList.add('opacity-0');
    }
  }, { passive: true });

  // ── Menú móvil ────────────────────────────────────────
  const btn = document.getElementById('menu-toggle');
  const menu = document.getElementById('mobile-menu');
  const iconOpen = document.getElementById('menu-icon-open');
  const iconClose = document.getElementById('menu-icon-close');

  btn?.addEventListener('click', () => {
    const isOpen = menu?.classList.contains('hidden');
    menu?.classList.toggle('hidden', !isOpen);
    btn.setAttribute('aria-expanded', String(isOpen));
    iconOpen?.classList.toggle('hidden', isOpen ?? false);
    iconClose?.classList.toggle('hidden', !isOpen);
  });

  // Cierra el menú al hacer clic en un enlace
  menu?.querySelectorAll('a').forEach(a => {
    a.addEventListener('click', () => {
      menu.classList.add('hidden');
      btn?.setAttribute('aria-expanded', 'false');
      iconOpen?.classList.remove('hidden');
      iconClose?.classList.add('hidden');
    });
  });

  // ── Tema oscuro ───────────────────────────────────────
  const themeBtn = document.getElementById('theme-toggle');
  const iconSun = document.getElementById('icon-sun');
  const iconMoon = document.getElementById('icon-moon');
  const root = document.documentElement;

  const savedTheme = localStorage.getItem('theme');
  if (savedTheme === 'dark' || (!savedTheme && window.matchMedia('(prefers-color-scheme: dark)').matches)) {
    root.classList.add('dark');
    iconSun?.classList.remove('hidden');
    iconMoon?.classList.add('hidden');
  }

  themeBtn?.addEventListener('click', () => {
    root.classList.toggle('dark');
    const isDark = root.classList.contains('dark');
    localStorage.setItem('theme', isDark ? 'dark' : 'light');
    iconSun?.classList.toggle('hidden', !isDark);
    iconMoon?.classList.toggle('hidden', isDark);
  });
</script>
