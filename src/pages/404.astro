---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout titulo="Página no encontrada — Luis Miguel Agud Sorlí" descripcion="Esta página no existe">
  <div class="min-h-screen flex items-center justify-center pt-16">
    <div class="text-center px-6">
      <p class="font-display text-[8rem] leading-none text-oro font-bold mb-4" aria-hidden="true">404</p>
      <h1 class="font-display text-display-md text-tinta dark:text-tinta-dark mb-4">Página no encontrada</h1>
      <p class="font-body text-gris mb-8 max-w-sm mx-auto">
        Esta página no existe o ha sido movida. Como los personajes perdidos, a veces hay que volver al principio.
      </p>
      <a href="/" class="btn-primary">Volver al inicio</a>
    </div>
  </div>
</BaseLayout>
